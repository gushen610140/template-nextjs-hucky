# 复制为 .env.development 或 .env.production 后再填写真实值
# 本文件只提交变量名，不提交任何真实值

# PostgreSQL 连接串
# 运行时连接（生产环境使用托管数据库的 pooled / 连接池地址）
DATABASE_URL=
# 迁移、seed、studio 使用的直连地址（不能是 PgBouncer transaction 池）
# 本地只有一个地址时，可以填与 DATABASE_URL 相同的值
MIGRATE_DATABASE_URL=

# Logto 应用
LOGTO_ENDPOINT=
LOGTO_APP_ID=
LOGTO_APP_SECRET=
LOGTO_BASE_URL=
LOGTO_COOKIE_SECRET=

# 首次部署的管理员邮箱（逗号分隔）。系统还没有管理员时，这些邮箱登录后
# 会自动获得 admin 角色；一旦存在管理员，本变量自动失效。
BOOTSTRAP_ADMIN_EMAILS=

# RustFS（S3 兼容对象存储）
# S3 API 地址，不是 9001 控制台端口。预签名 URL 以该地址签名，
# 因此浏览器必须能直接访问它（公网 HTTPS 域名）。
RUSTFS_ENDPOINT=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
# 私有 bucket，需在 RustFS 控制台提前创建，并为前端域名开启 CORS
# （PUT/GET/HEAD）。区域固定为 us-east-1，见 lib/storage/client.ts。
RUSTFS_BUCKET=

# OnlyOffice Document Server
# 浏览器和 Document Server 都能访问的地址，例如 https://office.example.com
ONLYOFFICE_DS_URL=
# 与 Document Server 的 JWT_SECRET 必须完全一致
ONLYOFFICE_JWT_SECRET=
# 可选：应用公网地址。留空时使用请求的 x-forwarded-host / host；
# 固定域名部署建议显式设置，避免代理头歧义。
APP_BASE_URL=
# 可选：DS 回调返回内部地址时用于校验，例如 http://127.0.0.1:8080
ONLYOFFICE_INTERNAL_URL=
