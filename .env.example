# 复制为 .env.development 或 .env.production 后再填写真实值
# 本文件只提交变量名，不提交任何真实值

# PostgreSQL 连接串
# 运行时连接（生产环境使用托管数据库的 pooled / 连接池地址）
DATABASE_URL=
# 迁移、seed、studio 使用的直连地址（不能是 PgBouncer transaction 池）
# 本地只有一个地址时，可以填与 DATABASE_URL 相同的值
MIGRATE_DATABASE_URL=

# Logto 应用
LOGTO_ENDPOINT=
LOGTO_APP_ID=
LOGTO_APP_SECRET=
LOGTO_BASE_URL=
LOGTO_COOKIE_SECRET=

# 首次部署的管理员邮箱（逗号分隔）。系统还没有管理员时，这些邮箱登录后
# 会自动获得 admin 角色；一旦存在管理员，本变量自动失效。
BOOTSTRAP_ADMIN_EMAILS=
