# 客户/团队应用凭证（与全局 feishu-bridge 不是同一个应用）
FEISHU_PM_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_PM_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 推送目标：二选一。群或私聊的 chat_id 优先，其次是用户 open_id
FEISHU_PM_NOTIFY_CHAT_ID=
FEISHU_PM_NOTIFY_OPEN_ID=

# 可选：设为 0 关闭推送
FEISHU_PM_ENABLED=1

# 可选：设为 0 关闭 AI 摘要（改为固定模板）
FEISHU_PM_SUMMARY=1

# 可选：AI 使用的模型与 agent。留空则继承 OpenCode 默认
# 格式 providerID/modelID，例如 opencode-go/deepseek-v4.1-flash
FEISHU_PM_MODEL=
FEISHU_PM_AGENT=

# 可选：接收群聊 @机器人 的需求
FEISHU_PM_RECEIVE=1
# 允许接收需求的群 chat_id，逗号分隔；留空则只允许 FEISHU_PM_NOTIFY_CHAT_ID
FEISHU_PM_ALLOWED_CHAT_IDS=
# 需求文档目录（相对项目根目录）
FEISHU_PM_REQUIREMENTS_DIR=requirements

# 可选：截图页面、开发/预览地址、页面校验文本、轮询间隔
FEISHU_SCREENSHOT_PAGES=/,/docs,/login
FEISHU_SCREENSHOT_BASE=http://localhost:3000
FEISHU_SCREENSHOT_MATCH=Hucky
FEISHU_SCREENSHOT_POLL_MS=20000
