# 飞书自建应用凭证（开放平台 -> 凭证与基础信息）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：只允许这些 open_id 使用，逗号分隔。留空 = 不限制（会打日志告警）
FEISHU_ALLOWED_OPEN_ID=

# 可选：feishu | lark
FEISHU_DOMAIN=feishu

# 可选：卡片 header 标题，默认 OpenCode
FEISHU_CARD_TITLE=OpenCode

# 可选：强制指定模型和 agent。留空 = 继承本目录最近一个非飞书会话
# 格式 providerID/modelID，例如 opencode-go/deepseek-v4.1-flash
FEISHU_MODEL=
FEISHU_AGENT=
