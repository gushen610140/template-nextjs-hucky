// RBAC 基础模型 — User / Role / Permission
// 使用: bunx prisma migrate dev --name init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── 用户 ──────────────────────────────────────────────

// 认证由 Logto 全权负责, 本地 User 只保存业务资料与授权关系。
// - logtoSub 是 Logto 的稳定用户标识 (id_token.sub), 作为唯一关联键
// - 邮箱在 Logto 侧允许变更, 因此不参与身份关联
// - 允许为空仅为了兼容尚未绑定 Logto 的历史数据 (本地密码已移除, 这类账号无法登录)
model User {
  id           String   @id @default(cuid())
  logtoSub     String?  @unique
  email        String   @unique
  name         String?
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles UserRole[]

  sessions Session[]
}

// ─── 角色 ──────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

// ─── 权限 ──────────────────────────────────────────────

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique // 如 "user:create", "post:publish"
  description String?
  module      String?          // 按模块分组，如 "user", "post", "settings"
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

// ─── 关联表 ────────────────────────────────────────────

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ─── 会话 ──────────────────────────────────────────────

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique // sha256(sessionToken)，不存明文
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
