// RBAC 基础模型 — User / Role / Permission
// 使用: bunx prisma migrate dev --name init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── 用户 ──────────────────────────────────────────────

// 认证由 Logto 全权负责, 本地 User 只保存业务资料与授权关系。
// - logtoSub 是 Logto 的稳定用户标识 (id_token.sub), 作为唯一关联键
// - 邮箱在 Logto 侧允许变更, 因此不参与身份关联
// - 允许为空仅为了兼容尚未绑定 Logto 的历史数据 (本地密码已移除, 这类账号无法登录)
model User {
  id        String   @id @default(cuid())
  logtoSub  String?  @unique
  email     String   @unique
  name      String?
  avatarUrl String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles UserRole[]

  sessions Session[]

  files FileObject[]

  folders FileFolder[]

  aiConversations AiConversation[]
}

// ─── 角色 ──────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

// ─── 权限 ──────────────────────────────────────────────

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique // 如 "user:create", "post:publish"
  description String?
  module      String? // 按模块分组，如 "user", "post", "settings"
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

// ─── 关联表 ────────────────────────────────────────────

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ─── 会话 ──────────────────────────────────────────────

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique // sha256(sessionToken)，不存明文
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── 文件 ──────────────────────────────────────────────

/// 对象生命周期:
/// - PENDING: 已签发预签名上传地址, 客户端尚未确认
/// - READY:   已校验对象存在, 可以下载
/// - DELETED: 软删除, 元数据保留, 对象本体在删除时清理
enum FileStatus {
  PENDING
  READY
  DELETED
}

/// 文件元数据。对象本体在 RustFS, 这里只存索引与归属关系。
/// - `key` 是 bucket 内的完整对象键, 全局唯一
/// - `name` 是用户可见的文件名, 与 `key` 解耦, 因此改名不需要移动对象
/// - `folderId` 为空表示根目录; 移动文件只改这一个字段, 不复制对象
model FileObject {
  id        String     @id @default(cuid())
  ownerId   String
  folderId  String?
  bucket    String
  key       String     @unique
  name      String
  mimeType  String
  size      BigInt
  etag      String?
  status    FileStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  owner  User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folder FileFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([ownerId, status, createdAt(sort: Desc)])
  @@index([ownerId, folderId, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

/// 虚拟文件夹: 只存在于数据库, 不映射到对象键前缀。
/// 移动文件不需要在存储侧做任何操作, 因此改名 / 移动都是纯元数据操作。
model FileFolder {
  id        String   @id @default(cuid())
  ownerId   String
  parentId  String?
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parent   FileFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children FileFolder[] @relation("FolderTree")
  files    FileObject[]

  @@index([ownerId, parentId, createdAt(sort: Desc)])
}

// ─── AI 供应商 / 模型 ──────────────────────────────────

/// 供应商类型决定用哪个 LangChain 适配器; OPENAI_COMPATIBLE 走 ChatOpenAI
/// 并允许自定义 baseUrl, 用于自建网关或兼容 OpenAI 协议的服务。
enum AiProviderType {
  OPENAI
  ANTHROPIC
  GOOGLE
  OPENAI_COMPATIBLE
}

/// 管理员配置的供应商。apiKeyCipher 是 AES-256-GCM 密文, 永不返回给客户端。
model AiProvider {
  id           String         @id @default(cuid())
  name         String         @unique
  type         AiProviderType
  baseUrl      String?
  apiKeyCipher String
  isActive     Boolean        @default(true)
  sortOrder    Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  models        AiModel[]
  conversations AiConversation[]

  @@index([isActive, sortOrder])
}

/// 管理员配置的模型。modelId 是供应商侧的请求标识 (如 gpt-4.1)。
model AiModel {
  id            String   @id @default(cuid())
  providerId    String
  modelId       String
  displayName   String
  contextWindow Int?
  maxTokens     Int?
  temperature   Float?
  params        Json?
  isActive      Boolean  @default(true)
  isDefault     Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  provider      AiProvider       @relation(fields: [providerId], references: [id], onDelete: Cascade)
  agents        AiAgent[]
  conversations AiConversation[]

  @@unique([providerId, modelId])
  @@index([providerId, isActive, sortOrder])
}

/// 管理员配置的智能体。用户只选择智能体, 由智能体决定模型与系统提示词。
/// RAG、skills 等能力后续通过独立关联表接入, 聊天路径只依赖 AiAgent。
model AiAgent {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  modelId      String
  systemPrompt String   @default("")
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  model         AiModel          @relation(fields: [modelId], references: [id], onDelete: Restrict)
  conversations AiConversation[]

  @@index([isActive, sortOrder])
}

// ─── AI 对话 ──────────────────────────────────────────

enum AiMessageRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

/// STREAMING: 流式生成中; ABORTED: 用户手动停止; FAILED: 生成出错。
enum AiMessageStatus {
  STREAMING
  COMPLETED
  FAILED
  ABORTED
}

/// 会话的 provider/model 是“当前选中模型”, 只影响下一条消息。
/// 同时保存名称快照, 供应商或模型被删除后会话列表仍可显示。
model AiConversation {
  id            String   @id @default(cuid())
  userId        String
  title         String
  agentId       String?
  agentName     String?
  providerId    String?
  modelId       String?
  providerName  String?
  modelName     String?
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent    AiAgent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  provider AiProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  model    AiModel?    @relation(fields: [modelId], references: [id], onDelete: SetNull)
  messages AiMessage[]

  @@index([userId, lastMessageAt(sort: Desc)])
}

/// 对话消息。每条 assistant 消息记录实际使用的模型快照, 支持会话中途换模型。
model AiMessage {
  id             String          @id @default(cuid())
  conversationId String
  sequence       Int
  role           AiMessageRole
  content        String
  status         AiMessageStatus @default(COMPLETED)
  providerName   String?
  modelName      String?
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime        @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, sequence])
  @@index([conversationId, sequence])
}
